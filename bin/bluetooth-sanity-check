#!/usr/bin/env bash
# bluetooth-sanity-check — Verify Bluetooth audio setup
# Supports Artix Linux with runit or OpenRC
# Run as regular user — no sudo needed

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BLUE='\033[0;34m'; BOLD='\033[1m'; NC='\033[0m'

pass()   { echo -e "  ${GREEN}✔${NC}  $*"; }
fail()   { echo -e "  ${RED}✘${NC}  $*"; FAILED=$((FAILED+1)); }
warn()   { echo -e "  ${YELLOW}⚠${NC}  $*"; WARNED=$((WARNED+1)); }
info()   { echo -e "  ${BLUE}→${NC}  $*"; }
header() { echo -e "\n${BOLD}$*${NC}"; echo "  ──────────────────────────────────────────"; }

FAILED=0; WARNED=0

# ── Detect init system ────────────────────────────────────────────────────────
if command -v sv &>/dev/null && [[ -d /run/runit ]]; then
  INIT="runit"
elif command -v rc-service &>/dev/null; then
  INIT="openrc"
else
  INIT="unknown"
fi

echo ""
echo -e "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}   Bluetooth Audio Sanity Check — Artix ($INIT)${NC}"
echo -e "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# ── 1. Bluetooth service ──────────────────────────────────────────────────────
header "1. Bluetooth Service ($INIT)"

if pgrep -x bluetoothd > /dev/null; then
  pass "bluetoothd is running"
else
  fail "bluetoothd is NOT running"
  case "$INIT" in
    runit)  info "Fix: sudo sv start bluetoothd" ;;
    openrc) info "Fix: sudo rc-service bluetoothd start" ;;
  esac
fi

case "$INIT" in
  runit)
    if [[ -L /run/runit/service/bluetoothd ]]; then
      pass "bluetoothd is enabled (linked in /run/runit/service/)"
    else
      warn "bluetoothd not enabled — run: sudo ln -s /etc/runit/sv/bluetoothd /run/runit/service/bluetoothd"
    fi
    pass "BlueZ --compat not required on Artix (WirePlumber 0.5.x+)"
    ;;
  openrc)
    if rc-update show 2>/dev/null | grep -q "bluetoothd.*default"; then
      pass "bluetoothd is enabled in default runlevel"
    else
      warn "bluetoothd not enabled — run: sudo rc-update add bluetoothd default"
    fi
    if [[ -f /etc/init.d/rfkill-unblock ]]; then
      pass "rfkill-unblock service exists"
    else
      warn "rfkill-unblock service missing — run setup.sh"
    fi
    if rc-update show 2>/dev/null | grep -q "rfkill-unblock.*boot"; then
      pass "rfkill-unblock is enabled at boot"
    else
      warn "rfkill-unblock not enabled — run: sudo rc-update add rfkill-unblock boot"
    fi
    ;;
esac

# ── 2. rfkill (OpenRC only — runit uses AutoEnable) ──────────────────────────
if [[ "$INIT" == "openrc" ]]; then
  header "2. rfkill Status"
  if rfkill list 2>/dev/null | grep -A2 "Bluetooth" | grep -q "Soft blocked: no"; then
    pass "Bluetooth is not rfkill blocked"
  else
    fail "Bluetooth is rfkill blocked — run: sudo rfkill unblock bluetooth"
  fi
fi

# ── 3. Bluetooth adapter ──────────────────────────────────────────────────────
header "3. Bluetooth Adapter"

CONTROLLER=$(bluetoothctl show 2>/dev/null | grep "Controller" | awk '{print $2}')
if [[ -n "$CONTROLLER" ]]; then
  pass "Adapter detected: $CONTROLLER"
else
  fail "No Bluetooth adapter detected — is the dongle plugged in?"
fi

POWERED=$(bluetoothctl show 2>/dev/null | grep "Powered:" | awk '{print $2}')
if [[ "$POWERED" == "yes" ]]; then
  pass "Adapter is powered on"
else
  fail "Adapter is powered OFF — run: bluetoothctl power on"
fi

if dmesg 2>/dev/null | grep -q "CSR: Unbranded CSR clone"; then
  warn "CSR clone dongle detected — known to be unreliable for audio"
else
  pass "No CSR clone warnings in dmesg"
fi

# ── 4. D-Bus session (OpenRC only) ───────────────────────────────────────────
if [[ "$INIT" == "openrc" ]]; then
  header "4. D-Bus Session"
  if [[ -n "$DBUS_SESSION_BUS_ADDRESS" ]]; then
    pass "DBUS_SESSION_BUS_ADDRESS is set"
  else
    fail "DBUS_SESSION_BUS_ADDRESS is not set — WirePlumber won't see BlueZ"
    info "Fix: add 'export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u)/bus' to ~/.xprofile"
  fi
  if [[ -n "$DISPLAY" ]]; then
    pass "DISPLAY is set ($DISPLAY) — X session appears active"
  else
    warn "DISPLAY not set — WirePlumber requires X session for Bluetooth"
  fi
fi

# ── 5. PulseAudio (must NOT be running) ───────────────────────────────────────
header "5. PulseAudio (must NOT be running)"
if pgrep -x pulseaudio > /dev/null; then
  fail "PulseAudio is running — conflicts with PipeWire!"
else
  pass "PulseAudio is not running"
fi

# ── 6. PipeWire ───────────────────────────────────────────────────────────────
header "6. PipeWire"

if pgrep -x pipewire > /dev/null; then
  pass "pipewire is running"
else
  fail "pipewire is NOT running"
fi

if pgrep -a pipewire 2>/dev/null | grep -q "pipewire-pulse.conf"; then
  pass "pipewire-pulse is running"
else
  fail "pipewire-pulse is NOT running"
fi

if pgrep -x wireplumber > /dev/null; then
  pass "wireplumber is running"
else
  fail "wireplumber is NOT running"
fi

if [[ "$INIT" == "runit" ]]; then
  if sv status ~/.config/sv/wireplumber 2>/dev/null | grep -q "^run:"; then
    pass "wireplumber runit service is up"
  else
    warn "wireplumber runit service not reporting"
  fi
fi

# Check WirePlumber logind disabled for OpenRC
if [[ "$INIT" == "openrc" ]]; then
  if [[ -f ~/.config/wireplumber/wireplumber.conf.d/disable-logind.conf ]]; then
    pass "WirePlumber logind disabled (required for xdm/VNC setups)"
  else
    warn "WirePlumber logind not disabled — Bluetooth may not work with xdm/VNC"
    info "Fix: run setup.sh"
  fi
fi

# ── 7. Disk space ─────────────────────────────────────────────────────────────
header "7. Disk Space"
DISK_USE=$(df / | awk 'NR==2 {print $5}' | tr -d '%')
DISK_AVAIL=$(df -h / | awk 'NR==2 {print $4}')
if [[ "$DISK_USE" -lt 90 ]]; then
  pass "Disk usage is ${DISK_USE}% (${DISK_AVAIL} free)"
elif [[ "$DISK_USE" -lt 97 ]]; then
  warn "Disk usage is ${DISK_USE}% (${DISK_AVAIL} free) — getting low"
  info "Clean up: sudo pacman -Sc"
else
  fail "Disk is ${DISK_USE}% full — WirePlumber will fail to save state!"
  info "Clean up: sudo pacman -Sc"
fi

# ── 8. Bluetooth audio devices ───────────────────────────────────────────────
header "8. Bluetooth Audio Devices"
BT_CARDS=$(pactl list cards 2>/dev/null | awk '/^\tName:/ && /bluez_card/ {print $2}')
if [[ -n "$BT_CARDS" ]]; then
  while IFS= read -r card; do
    pass "Bluetooth card detected: $card"
    PROFILE=$(pactl list cards 2>/dev/null | grep -A 50 "$card" | \
      grep "Active Profile" | head -1 | awk -F': ' '{print $2}')
    if [[ "$PROFILE" == "a2dp-sink" ]]; then
      pass "Active profile: ${GREEN}a2dp-sink${NC} (high quality stereo ✔)"
    elif [[ "$PROFILE" == "off" ]] || [[ -z "$PROFILE" ]]; then
      warn "Active profile is '$PROFILE' — device may not be connected"
      info "Fix: bluetoothctl connect <MAC> then pactl set-card-profile $card a2dp-sink"
    else
      warn "Active profile is '$PROFILE' — expected a2dp-sink"
      info "Fix: pactl set-card-profile $card a2dp-sink"
    fi
  done <<< "$BT_CARDS"
else
  warn "No Bluetooth audio cards found — is a device connected?"
  info "Connect: bluetoothctl connect <MAC>"
fi

# ── 9. Trusted devices ───────────────────────────────────────────────────────
header "9. Trusted Bluetooth Devices"
TRUSTED=$(bluetoothctl devices Trusted 2>/dev/null | grep "^Device")
if [[ -n "$TRUSTED" ]]; then
  while IFS= read -r device; do
    NAME=$(echo "$device" | cut -d' ' -f3-)
    MAC=$(echo "$device" | cut -d' ' -f2)
    CONNECTED=$(bluetoothctl info "$MAC" 2>/dev/null | grep "Connected:" | awk '{print $2}')
    if [[ "$CONNECTED" == "yes" ]]; then
      pass "$NAME ($MAC) — trusted & connected"
    else
      info "$NAME ($MAC) — trusted but not connected"
    fi
  done <<< "$TRUSTED"
else
  warn "No trusted devices found"
fi

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
if [[ $FAILED -eq 0 ]] && [[ $WARNED -eq 0 ]]; then
  echo -e "${GREEN}${BOLD}  All checks passed! Bluetooth audio is healthy.${NC}"
elif [[ $FAILED -eq 0 ]]; then
  echo -e "${YELLOW}${BOLD}  Passed with $WARNED warning(s). Review warnings above.${NC}"
else
  echo -e "${RED}${BOLD}  $FAILED failure(s) and $WARNED warning(s). Review above.${NC}"
fi
echo -e "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
