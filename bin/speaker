#!/usr/bin/env bash
# speaker.sh — Switch audio output to analogue speakers
# Must NOT be run as root — talks to user PipeWire/bluetoothctl session
if [[ $EUID -eq 0 ]]; then
  echo "✘ Do not run this script with sudo — run as regular user: $(basename $0)"
  exit 1
fi


SINK="alsa_output.pci-0000_00_1b.0.analog-stereo"

# Disconnect Bluetooth if connected
BT_CONNECTED=$(bluetoothctl info 94:4B:F8:01:52:02 2>/dev/null | grep "Connected: yes")
if [[ -n "$BT_CONNECTED" ]]; then
  echo "Disconnecting TOZO T10..."
  bluetoothctl disconnect 94:4B:F8:01:52:02
  echo "Waiting for TOZO to disconnect fully..."
  sleep 5
fi

echo "Powering off Bluetooth adapter..."
bluetoothctl power off

echo "Switching to speakers..."
pactl set-default-sink "$SINK"

# Restart MPD if running
if systemctl --user is-active --quiet mpd; then
  systemctl --user restart mpd
fi

echo "✔ Audio → Speakers"
