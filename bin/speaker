#!/usr/bin/env bash
# speaker — Switch audio output to analogue speakers
# Artix Linux — runit
# Must NOT be run as root

if [[ $EUID -eq 0 ]]; then
  echo "✘ Do not run with sudo — run as regular user: $(basename $0)"
  exit 1
fi

MAC="94:4B:F8:01:52:02"
SINK=$(pactl list sinks short 2>/dev/null | grep -v bluez | grep analog-stereo | awk '{print $2}' | head -1)

restart_user_service() {
  local svc=$1
  sv restart ~/.config/sv/"$svc" 2>/dev/null || true
}

restart_mpd() {
  if pgrep -x mpd > /dev/null; then
    restart_user_service mpd
  fi
}

# ── Disconnect Bluetooth if connected ─────────────────────────────────────────
BT_CONNECTED=$(bluetoothctl info "$MAC" 2>/dev/null | grep "Connected: yes")
if [[ -n "$BT_CONNECTED" ]]; then
  echo "Disconnecting TOZO T10..."
  bluetoothctl disconnect "$MAC"
  echo "Waiting for TOZO to disconnect fully..."
  sleep 5
fi

echo "Powering off Bluetooth adapter..."
bluetoothctl power off

if [[ -z "$SINK" ]]; then
  echo "✘ No analog sink found — is the sound card available?"
  exit 1
fi

echo "Switching to speakers ($SINK)..."
pactl set-default-sink "$SINK"

restart_mpd

echo "✔ Audio → Speakers"
